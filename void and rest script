-- ==========================================================
-- ★ 按键监听
-- ==========================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isListeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            exitKeyListenMode(input.KeyCode)
        end
        return
    end

    if gameProcessed then return end

    -- 输入框正在打字时，不要触发快捷键
    if exactBox:IsFocused() then return end

    if input.KeyCode == RESPAWN_KEY then
        ForceRespawn()
    end

    if input.KeyCode == TOGGLE_KEY then
        respawnState.enabled = not respawnState.enabled
        updateMonitor()
        print("[强制重生] " .. (respawnState.enabled and "已开启" or "已关闭"))
    end

    if input.KeyCode == MONITOR_HIDE_KEY then
        monitorPanel.Visible = not monitorPanel.Visible
        print("[监控] 面板 " .. (monitorPanel.Visible and "已显示" or "已隐藏"))
    end

    if input.KeyCode == VOID_PANEL_KEY then
        voidPanel.Visible = not voidPanel.Visible
        print("[虚空] 控制面板 " .. (voidPanel.Visible and "已显示" or "已隐藏"))
    end
end)

