-- ★ Void Tool（现在读 voidState.y，不再写死）
-- ==========================================================
local function createVoidTool()
    local tool = Instance.new("Tool")
    tool.Name = "Void"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.ToolTip = "装备下去，卸下回来"

    tool.Equipped:Connect(function()
        local char, hrp = getChar()
        if not hrp then return end
        if hrp.Position.Magnitude < 1 then return end

        voidState.savedCFrame = hrp.CFrame
        voidState.inVoid = true
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(hrp.Position.X, voidState.y, hrp.Position.Z)

        voidStatus.Text = "已下潜到 Y = " .. voidState.y .. "（拖滑条实时调）"
        print("[Void] 已传送到 Y = " .. voidState.y)
    end)

    tool.Unequipped:Connect(function()
        local char, hrp = getChar()
        if not hrp then return end

        voidState.inVoid = false
        if voidState.savedCFrame then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = voidState.savedCFrame
            voidState.savedCFrame = nil
            voidStatus.Text = "装备 Void 时生效"
            print("[Void] 已返回原位")
        end
    end)

    return tool
end

local function giveTool()
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then return end
    if backpack:FindFirstChild("Void") then return end

    local tool = createVoidTool()
    tool.Parent = backpack
    print("[Void] 工具已放入背包")
end

task.spawn(function()
    if not player.Character then
        player.CharacterAdded:Wait()
    end
    task.wait(2)
    giveTool()
end)

player.CharacterAdded:Connect(function(char)
    voidState.savedCFrame = nil
    voidState.inVoid = false
    voidStatus.Text = "装备 Void 时生效"
    task.wait(1)
    giveTool()
end)

