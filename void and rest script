-- ★ 设置虚空 Y（核心）
-- ----------------------------------------------------------
local function setVoidY(rawValue, doSave)
    local v = math.clamp(math.floor(rawValue + 0.5), VOID_HARD_MIN, VOID_MAX)
    voidState.y = v
    voidValueLabel.Text = tostring(v)
    voidUnitLabel.Text = "studs"

    -- 超出滑条范围时，滑块钉在两端（数值仍然生效）
    local t = math.clamp((v - VOID_MIN) / (VOID_MAX - VOID_MIN), 0, 1)
    sliderFill.Size = UDim2.new(t, 0, 1, 0)
    sliderKnob.Position = UDim2.new(t, 0, 0.5, 0)

    -- 已经在虚空里 → 实时把人挪到新深度，拖滑条就是下潜/上浮
    if voidState.inVoid then
        local _, hrp = getChar()
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = CFrame.new(hrp.Position.X, v, hrp.Position.Z)
        end
    end

    if doSave then
        saveVoidY()
    end
end

