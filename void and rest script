-- 存档文件（支持 writefile 的执行器才会持久化，不支持的会静默跳过）
local VOID_SAVE_FILE = "RevenantVoidY.txt"

local function loadVoidY()
    local ok, data = pcall(function()
        if type(isfile) == "function" and isfile(VOID_SAVE_FILE) then
            return readfile(VOID_SAVE_FILE)
        end
        return nil
    end)
    if ok and type(data) == "string" then
        local n = tonumber(data)
        if n then
            return math.clamp(n, VOID_MIN, VOID_MAX)
        end
    end
    return VOID_DEFAULT
end

local function saveVoidY()
    pcall(function()
        if type(writefile) == "function" then
            writefile(VOID_SAVE_FILE, tostring(voidState.y))
        end
    end)
end

voidState.y = loadVoidY()

