local VOID_MAX = -100          -- 滑条上限（-100 已经很浅了，再高就等于没下潜）
local VOID_HARD_MIN = -1000000 -- 输入框允许的极限深度（滑条范围外也能手输）
local VOID_DEFAULT = -10000    -- 默认值 / 重置值

