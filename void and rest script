-- ★ 强制重生核心
-- ==========================================================
local function ForceRespawn()
    if not respawnState.enabled then
        print("[强制重生] 当前已关闭，按 N 开启")
        return
    end

    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            hum.Health = 0
            respawnState.lastTriggered = tick()
            respawnState.triggerCount = respawnState.triggerCount + 1
            updateMonitor()
            print("[强制重生] 已触发 (第 " .. respawnState.triggerCount .. " 次)")
        end
    end
end

