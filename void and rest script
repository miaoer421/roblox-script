local draggingSlider = false

local function sliderValueFromScreenX(screenX)
    local trackX = sliderTrack.AbsolutePosition.X
    local trackW = sliderTrack.AbsoluteSize.X
    if trackW <= 0 then return voidState.y end
    local t = math.clamp((screenX - trackX) / trackW, 0, 1)
    local v = VOID_MIN + t * (VOID_MAX - VOID_MIN)
    v = math.floor(v / 10 + 0.5) * 10        -- 吸附到 10 的倍数
    return math.clamp(v, VOID_MIN, VOID_MAX)
end

sliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingSlider = true
        setVoidY(sliderValueFromScreenX(UserInputService:GetMouseLocation().X), false)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not draggingSlider then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        setVoidY(sliderValueFromScreenX(UserInputService:GetMouseLocation().X), false)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        setVoidY(sliderValueFromScreenX(input.Position.X), false)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not draggingSlider then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingSlider = false
        saveVoidY()
    end
end)

